# DeepL API key (free tier: https://www.deepl.com/pro-api)
DEEPL_API_KEY=your_deepl_api_key_here

# Google Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# RunPod serverless (for Full Pipeline mode)
# Create an endpoint at https://www.runpod.io/console/serverless
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# HuggingFace token (for pyannote speaker diarization model)
# Get one at https://huggingface.co/settings/tokens
# Accept model terms at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=your_hf_token_here
